{
  "extends": "../tsconfig.app.json",
  "compilerOptions": {
    "outDir": "../dist/out-tsc",
    "types": []
  },
  "files": ["main.ts"],
  "include": [
    "**/*.ts"
  ],
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  }
}
